From 2e91f6075e192c677a59ebaacb26065789a019a8 Mon Sep 17 00:00:00 2001
From: Abhishek Kunati <itsmekunati@gmail.com>
Date: Thu, 5 Nov 2026 20:22:04 +0000
Subject: [PATCH 3/8] octet: new regtest genesis block (own message, 2026-11-05
 timestamp, OP_RETURN output)

Header mined offline with a small script; nonce 0 already satisfies the
0x207fffff target. The C++ asserts in CRegTestParams re-derive the block hash
and merkle root, so a serialization mismatch aborts at startup. Main/testnet/
signet genesis blocks are not yet replaced. Genesis will need re-mining when the
PoW hash changes in phase 2.
---
 src/kernel/chainparams.cpp | 18 +++++++++++++++---
 1 file changed, 15 insertions(+), 3 deletions(-)

diff --git a/src/kernel/chainparams.cpp b/src/kernel/chainparams.cpp
index 95c3ee3..744af37 100644
--- a/src/kernel/chainparams.cpp
+++ b/src/kernel/chainparams.cpp
@@ -73,6 +73,18 @@ static CBlock CreateGenesisBlock(uint32_t nTime, uint32_t nNonce, uint32_t nBits
     return CreateGenesisBlock(pszTimestamp, genesisOutputScript, nTime, nNonce, nBits, nVersion, genesisReward);
 }
 
+/**
+ * Octet genesis block. Same layout as the Bitcoin one (coinbase scriptSig
+ * commits to a message), but with our own message and an OP_RETURN output so
+ * there is no spendable key attached to the genesis coinbase.
+ */
+static CBlock CreateOctetGenesisBlock(uint32_t nTime, uint32_t nNonce, uint32_t nBits, int32_t nVersion, const CAmount& genesisReward)
+{
+    const char* pszTimestamp = "05/Nov/2026 One CPU, one vote. Octet regtest genesis";
+    const CScript genesisOutputScript = CScript() << OP_RETURN;
+    return CreateGenesisBlock(pszTimestamp, genesisOutputScript, nTime, nNonce, nBits, nVersion, genesisReward);
+}
+
 void CChainParams::ApplyDeploymentOptions(const DeploymentOptions& opts)
 {
     for (const auto& [dep, height] : opts.activation_heights) {
@@ -609,10 +621,10 @@ public:
 
         ApplyDeploymentOptions(opts.dep_opts);
 
-        genesis = CreateGenesisBlock(1296688602, 2, 0x207fffff, 1, 50 * COIN);
+        genesis = CreateOctetGenesisBlock(1793836800, 0, 0x207fffff, 1, 50 * COIN);
         consensus.hashGenesisBlock = genesis.GetHash();
-        assert(consensus.hashGenesisBlock == uint256{"0f9188f13cb7b2c71f2a335e3a4fc328bf5beb436012afca590b1a11466e2206"});
-        assert(genesis.hashMerkleRoot == uint256{"4a5e1e4baab89f3a32518a88c31bc87f618f76673e2cc77ab2127b7afdeda33b"});
+        assert(consensus.hashGenesisBlock == uint256{"6ee6e272ca2a52d0b086c686ab1c68e0cd1a5e59226a5db2ddc0ee7b7dd83abc"});
+        assert(genesis.hashMerkleRoot == uint256{"aea56117ce8b82dbb92c2cd66dea2fe60ff52b7f5783450464d8ab7f6f98745c"});
 
         vFixedSeeds.clear(); //!< Regtest mode doesn't have any fixed seeds.
         vSeeds.clear();
