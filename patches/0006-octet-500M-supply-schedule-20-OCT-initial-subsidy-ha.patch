 src/consensus/params.h                       |  3 +++
 src/kernel/chainparams.cpp                   | 13 +++++++++----
 src/test/compress_tests.cpp                  |  4 ++--
 src/test/validation_tests.cpp                |  9 +++++----
 src/validation.cpp                           |  4 ++--
